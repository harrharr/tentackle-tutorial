<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>tracker</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jlink</artifactId>
  <packaging>pom</packaging>
  <name>Tracker JLink Images</name>
  <description>Parent for the JLink Modules</description>

  <profiles>
    <profile>
      <id>jlink</id>
      <modules>
        <module>server</module>
        <module>client</module>
        <module>daemon</module>
      </modules>
    </profile>
  </profiles>

  <properties>
    <rootBasedir>${project.parent.basedir}</rootBasedir>
    <cert.dname>cn=${serverHost}, ou=Tracker, o=Example, c=US</cert.dname>
    <cert.password>didoedeldu</cert.password>
    <cert.dir>${project.build.directory}/pkcs12</cert.dir>
    <cert.file>${project.parent.basedir}/server/target/server.cer</cert.file>
    <cert.alias>server</cert.alias>
    <dbService>trips://${serverHost}:8888/TrackerServer</dbService>
    <updateService>tripe://${serverHost}:8890/TrackerUpdate</updateService>

    <!--
      Tutorial CA signing the client certificates of the client and daemon images.
      It is generated by the server module into target/ca, outside the packaged pkcs12 directory,
      so its private key never ends up in an image.
      A real deployment keeps its CA outside the build and issues the client certificates per user.
    -->
    <ca.dir>${project.parent.basedir}/server/target/ca</ca.dir>
    <ca.keystore>${ca.dir}/ca.p12</ca.keystore>
    <ca.file>${ca.dir}/ca.cer</ca.file>
    <ca.alias>ca</ca.alias>
    <ca.password>gruenkohl</ca.password>
    <ca.dname>cn=Tracker CA, ou=Tracker, o=Example, c=US</ca.dname>

    <!-- client certificate: client.cert.user and client.cert.password are set by the client and daemon modules -->
    <client.cert.dname>cn=${client.cert.user}, ou=Tracker, o=Example, c=US</client.cert.dname>
    <client.cert.alias>client</client.cert.alias>
    <client.cert.csr>${project.build.directory}/client.csr</client.cert.csr>
    <client.cert.file>${project.build.directory}/client.cer</client.cert.file>
  </properties>

  <build>

    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/src/main/filtered-resources</directory>
        <filtering>true</filtering>
      </resource>
      <!--  additional resource directory for generated key- and truststores -->
      <resource>
        <directory>${project.build.directory}/pkcs12</directory>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.tentackle</groupId>
        <artifactId>tentackle-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>properties</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <verbosity>info</verbosity>
          <propertyDescriptors>
            <propertyDescriptor>
              <input>${dbPasswd}</input>
              <converter>@org.tentackle.common.Cryptor</converter>
              <property>encryptedPasswd</property>
            </propertyDescriptor>
            <propertyDescriptor>
              <input>${cert.password}</input>
              <converter>@org.tentackle.common.Cryptor</converter>
              <property>encryptedCertPasswd</property>
            </propertyDescriptor>
          </propertyDescriptors>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.example</groupId>
            <artifactId>tracker-common</artifactId>
            <version>${project.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <configuration>
          <attach>false</attach>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
